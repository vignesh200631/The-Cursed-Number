  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::OpeningStoryController
  openingStoryPanel: {fileID: 8267962646531387213}
  storyText: {fileID: 7397809957403565481}
  playerController: {fileID: 0}
  playerInteraction: {fileID: 0}
  openingStory: 'Deep within an ancient land, a forgotten secret lies buried.


    An
    archaeologist has arrived at a remote village after discovering an ancient inscription
    mentioning the mysterious number seven.


    But something is wrong. The villagers
    fear the number seven, and their king has forbidden anyone from speaking of it.


    Determined
    to uncover the truth, the archaeologist begins investigating the village.'
